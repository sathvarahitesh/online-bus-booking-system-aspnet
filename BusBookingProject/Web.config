<configuration>
	<system.web>
		<compilation debug="true" targetFramework="4.8"/>
		<httpRuntime targetFramework="4.5"/>
		<customErrors mode="Off"/>
	</system.web>

	<!-- Connection Strings -->
	<connectionStrings>
		<!-- Modified connection string without TrustServerCertificate -->
		<add name="OnlineBusBookingConnectionString"
			 connectionString="Data Source=HITESH_SATVARA\SQLEXPRESS;Initial Catalog=OnlineBusBooking;Integrated Security=True;"
			 providerName="System.Data.SqlClient"/>
	</connectionStrings>

	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
	</appSettings>
</configuration>
